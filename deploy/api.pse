#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Radar Brasil — porta de entrada (instalado no webroot).

Este mesmo arquivo serve a DOIS mundos:

1) WEB (nginx + fcgiwrap): entra como CGI. O nginx/fcgiwrap da casa NAO define
   PATH_INFO (so QUERY_STRING/REQUEST_URI), entao a rota vai no parametro
   `rota`:

       /openclaw/radar/api.pse?rota=/api/v1/radares&lat=..&lon=..&raio=..&formato=txt
       /openclaw/radar/api.pse?rota=/api/v1/ajuda

2) CONSOLE (linha de comando do servidor): rodando fora do CGI (sem
   GATEWAY_INTERFACE/REQUEST_METHOD) ele PERCEBE que esta no terminal e abre
   as opcoes de console em vez de responder HTTP:

       ./api.pse                  # menu interativo
       ./api.pse pendentes
       ./api.pse cadastro P-1130
       ./api.pse senha admin
       ./api.pse ajuda

So isto mora no webroot; o aplicativo fica em /home/openclaw/bin/radar.
"""
import os
import sys
import urllib.parse

os.environ.setdefault("RADAR_BRASIL_HOME", "/home/openclaw/bin/radar")
os.environ.setdefault("RADAR_DB", "/var/lib/radar-brasil/radar.sqlite3")
os.environ.setdefault("RADAR_DATA_DIR", "/var/lib/radar-brasil")

_raiz = os.environ["RADAR_BRASIL_HOME"]
if _raiz not in sys.path:
    sys.path.insert(0, _raiz)


def _sob_cgi(environ=None):
    """True se estiver rodando sob o servidor web (CGI/FastCGI)."""
    environ = environ if environ is not None else os.environ
    return bool(environ.get("GATEWAY_INTERFACE") or environ.get("REQUEST_METHOD"))


if not _sob_cgi():
    # Rodando no console do servidor: modo terminal.
    from web import terminal  # noqa: E402
    sys.exit(terminal.main(sys.argv[1:]))

if not os.environ.get("PATH_INFO"):
    _qs = urllib.parse.parse_qs(os.environ.get("QUERY_STRING", ""))
    _rota = (_qs.get("rota") or _qs.get("path") or [""])[0]
    os.environ["PATH_INFO"] = _rota or "/api/v1/ajuda"

from web.nucleo import main   # noqa: E402

if __name__ == "__main__":
    main()
