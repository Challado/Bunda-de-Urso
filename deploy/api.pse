#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Radar Brasil — porta de entrada (instalado no webroot).

Este mesmo arquivo serve a DOIS mundos:

1) WEB (nginx + fcgiwrap): entra como CGI. O nginx/fcgiwrap da casa NAO define
   PATH_INFO (so QUERY_STRING/REQUEST_URI), entao a rota vai no parametro
   `rota`:

       <prefixo>/api.pse?rota=/api/v1/radares&lat=..&lon=..&raio=..&formato=txt
       <prefixo>/api.pse?rota=/api/v1/ajuda

2) CONSOLE (linha de comando do servidor): rodando fora do CGI (sem
   GATEWAY_INTERFACE/REQUEST_METHOD) ele PERCEBE que esta no terminal e abre
   as opcoes de console em vez de responder HTTP:

       ./api.pse                  # menu interativo
       ./api.pse pendentes
       ./api.pse cadastro P-1130
       ./api.pse senha admin
       ./api.pse ajuda

O radar.conf ao lado desta entrada define os caminhos, relativos a sua pasta.
RADAR_CONF pode selecionar outro arquivo; nao ha busca automatica ou overrides.
Nenhum caminho de producao pertence a este arquivo.
"""
import os
import sys

CONF_PADRAO = os.path.join(os.path.dirname(os.path.abspath(__file__)), "radar.conf")
if not (os.environ.get("RADAR_CONF") or "").strip():
    os.environ["RADAR_CONF"] = CONF_PADRAO

# Um arquivo selecionado ausente nunca aciona outra configuracao ou outra base.
_cgi = bool(os.environ.get("GATEWAY_INTERFACE") or os.environ.get("REQUEST_METHOD"))
_criar_configuracao = not _cgi and sys.argv[1:2] == ["instalacao"] and "--perfil-conf" in sys.argv
if not os.path.isfile(os.environ["RADAR_CONF"]) and not _criar_configuracao:
    if os.environ.get("GATEWAY_INTERFACE") or os.environ.get("REQUEST_METHOD"):
        print('Status: 503 Service Unavailable\r\nContent-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\n\r\n{"erro":{"codigo":"configuracao_ausente","mensagem":"O arquivo de configuracao selecionado nao foi encontrado."}}')
    else:
        print("Radar Brasil: configuracao nao encontrada: " + os.environ["RADAR_CONF"], file=sys.stderr)
    raise SystemExit(2)


def _conf(secao, chave):
    """Le uma chave do .conf sem depender de nada (o core ainda nao existe aqui)."""
    caminho = (os.environ.get("RADAR_CONF") or "").strip() or CONF_PADRAO
    atual = None
    try:
        with open(caminho, "r", encoding="utf-8") as f:
            for linha in f:
                texto = linha.strip()
                if not texto or texto[0] in "#;":
                    continue
                if texto.startswith("[") and texto.endswith("]"):
                    atual = texto[1:-1].strip().lower()
                    continue
                if atual != secao or "=" not in texto:
                    continue
                nome, valor = texto.split("=", 1)
                if nome.strip().lower() == chave:
                    return os.path.expanduser(valor.strip().strip('"').strip("'"))
    except OSError:
        pass
    return ""


_raiz = _conf("instalacao", "home")
if not _raiz:
    # Sem configuracao: o checkout desta instalacao (webroot dentro do projeto).
    _aqui = os.path.dirname(os.path.abspath(__file__))
    for _cand in (_aqui, os.path.dirname(_aqui)):
        if os.path.isdir(os.path.join(_cand, "core")):
            _raiz = _cand
            break
if not _raiz:
    sys.exit("Radar Brasil: caminho do codigo nao configurado. "
             "Defina [instalacao] home em %s." % CONF_PADRAO)

# Bootstrap resolve somente o codigo. Dados e demais opcoes pertencem ao core.
if not os.path.isabs(_raiz):
    _raiz = os.path.join(os.path.dirname(os.path.abspath(
        os.environ.get("RADAR_CONF") or CONF_PADRAO)), _raiz)

if _raiz not in sys.path:
    sys.path.insert(0, _raiz)

from core.entrada_api import main   # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
