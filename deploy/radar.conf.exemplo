# Radar Brasil — configuracao da instalacao
#
# Este arquivo diz AO PROGRAMA onde estao as coisas. O codigo nao sabe (e nao
# deve saber) caminho de producao: ele pergunta aqui.
#
#   LOCAL:  radar.conf na raiz da instalacao (www-data:www-data, 0660)
#   OUTRO:  RADAR_CONF=/caminho/alternativo (util para teste)
#
# RADAR_CONF seleciona o arquivo. Somente este arquivo fornece os parametros.
# Sem este arquivo nada quebra — o programa usa os diretorios do proprio
# repositorio (bom para desenvolvimento e CI).
#
# dados.dir relativo resolve contra a pasta DESTE arquivo.
# Banco, logs, tokens, chaves, malha e clone ficam sempre dentro de dados.dir.
# Seus caminhos relativos resolvem contra dados.dir; escapes sao recusados.
# Depois de editar, confira o que o programa entendeu:
#
#     python3 /caminho/do/codigo/web/api.pse configuracao mostrar

[instalacao]
# Raiz do codigo instalado: onde ficam core/, coletor/, web/, sql/.
# E o diretorio que o cron, o nginx e os scripts usam como referencia.
home = .

# A identidade vem do processo que executa o aplicativo; nao ha usuario/grupo aqui.

[dados]
# Diretorio de dados: banco, arquivos brutos (raw/), staging/ e calibracao/.
dir = dados

# Banco SQLite de producao. Vazio = <dir>/radar.sqlite3
banco = radar.sqlite3

[web]
# Webroot servido pelo nginx/fcgiwrap (onde mora o api.pse instalado).
raiz = .

# Prefixo publico da consulta (usado em links). Sem barra no fim e aceito.
url = /
# Origem HTTP(S) opcional para verificar API e pagina pelo endereco publicado.
origem =

[interface]
# Percentual minimo do espaco util (sem cabecalho, controles e rodape) para o mapa.
mapa_min_percentual = 50
# Altura minima legivel em pixels; telas muito baixas podem precisar de rolagem.
mapa_min_altura_px = 180

[logs]
# Logs do tick e do dados-sync (o logrotate le daqui).
dir = logs

[api]
token_arquivo = api_token
max_body = 8388608
proxies_confiaveis =

[coleta]
max_bytes = 52428800
timeout = 30
tentativas = 3
# Tempo maximo em segundos para o atualizador esperar uma coleta em andamento.
espera_atualizacao = 300

[governanca]
raio_correspondencia_m = 150
raio_zona_sombra_m = 1000
submissao_limite = 20
submissao_janela_segundos = 3600
sessao_ttl_segundos = 28800
gov_iteracoes = 200000

[geografia]
# Vazio usa a malha distribuida com o codigo/cache. Pode indicar outra malha.
malha =

[assistente]
# Interruptor geral: 0 impede TODAS as chamadas de IA, inclusive manutencao antiga.
habilitado = 0
# ollama ou openai_compativel (OpenAI e provedores com Chat Completions).
provedor = ollama
url = http://127.0.0.1:11434
modelo = gemma4:26b
# Externo: URL base HTTPS, ex. https://api.openai.com/v1, e o modelo contratado.
# A chave e gravada separadamente pelo painel; nunca coloque o valor neste arquivo.
# Vazio usa assistente_chave dentro de dados.dir. Nao aceita chave por ambiente.
chave_arquivo =
timeout = 20
max_entrada = 20000
max_saida_tokens = 1024
max_chamadas = 10
# Permissoes por tarefa; so valem quando habilitado = 1.
documentos = 1
correspondencias = 1
auditoria = 1
diagnostico = 1
explicacoes = 1
municipios = 1

# Recebimento rapido do formulario: JSON duravel em <dados.dir>/fila-cadastros.
# Cron da fila separado do coletor, pela api.pse. Nenhuma IA e necessaria.
[cadastro]
max_itens = 100
max_bytes = 262144
max_pendentes = 10000
lote = 20
tentativas = 5
retencao_dias = 30

# TRASEIRO DE URSO - rede mesh. Nao consulta nada enquanto habilitado=0.
[traseiro]
habilitado = 0
nome = TRASEIRO DE URSO
# Vazio deriva de web.origem + web.url + api.pse. Use HTTPS publico.
api_url =
# livre ou tokens. Tokens/chaves nunca sao enviados no bloco publico.
acesso = tokens
tokens_arquivo = traseiro_tokens.json
# APIs iniciais separadas por virgula; novos pares sao descobertos pela rede.
pares =
# Intervalo minimo que OS OUTROS devem esperar para consultar ESTA instancia.
intervalo_segundos = 300
# O tipo seleciona EXCLUSIVAMENTE um criterio, usando o mesmo numero.
inatividade_tipo = tentativas
inatividade_numero = 5
# Prazos contados uma vez ao armar/alterar a programacao; nao a cada consulta.
# Com parada_programada=1: parar daqui N s, retornar daqui M s.
# Retorno 0 significa nao voltar. Instancia parada nao pode consultar pares.
# Para cancelar, desative a programacao e zere os dois prazos.
parada_programada = 0
parar_em_segundos = 0
retornar_em_segundos = 0
lote = 100
max_bytes = 2097152
max_pendentes = 10000
max_instancias = 100
pares_por_tick = 4
fontes_por_tick = 1
# Servidor inativo por falha pode ser sondado; parada anunciada nunca e sondada.
sondagem_segundos = 86400
timeout = 15
