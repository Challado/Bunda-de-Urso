RADAR_DATABASE_URL=sqlite:////var/lib/radarbrasil/radares.sqlite3
RADAR_CACHE_DIR=/var/lib/radarbrasil/cache
RADAR_LOG_DIR=/var/log/radarbrasil
RADAR_CONFIG=/etc/radarbrasil/sources.json
RADAR_REQUEST_TIMEOUT=45
RADAR_CONNECT_TIMEOUT=12
RADAR_MAX_BYTES=52428800
RADAR_USER_AGENT=RadarBrasil/1.0 (+contato-do-operador@example.org)
RADAR_MAX_RADIUS=50000
RADAR_MAX_RESULTS=1000
RADAR_CACHE_WARNING_HOURS=24
RADAR_CACHE_CRITICAL_HOURS=168
RADAR_ADMIN_TOKEN=
RADAR_HTTP_MAX_BODY=65536
